# Railway 正式環境：加入 PostgreSQL 服務後，使用 reference variable
DATABASE_URL=postgresql://username:password@hostname:5432/railway
NODE_ENV=production
# 首次啟動建立管理員；請自行設定，不提供預設密碼
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Railway 會提供 PORT；本機可自行設定
PORT=3000
# 本機無 PostgreSQL 時可使用 PGlite，正式環境禁止此模式
# LOCAL_DB=1
